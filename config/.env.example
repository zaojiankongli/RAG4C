# =============================================================================
# RAG4C 配置示例 —— 复制为 .env 后按需修改
#
# 环境变量命名规则：RAG4C_<SECTION>_<KEY>（全部大写，下划线连接）
#   嵌套段再拼一层：如 LLM 槽位是 RAG4C_LLM_<SLOT>_<KEY>（slot = rewrite / router_llm / generation / judge）
#
# 也可以直接 export RAG4C_* 环境变量，优先级高于 .env 文件。
# =============================================================================

# ---------------------------------------------------------------------------
# [milvus] 向量数据库
# ---------------------------------------------------------------------------
# uri 决定运行模式：
#   - 本地文件路径（./rag4c.db）   -> Milvus Lite（零部署，pip install "pymilvus[milvus-lite]"）
#   - http://localhost:19530      -> Milvus server / Docker 部署
#   - https://xxx.api.zillizcloud.com -> Zilliz Cloud（配合 token）
# 注意：BM25 稀疏检索由 Milvus 内置 Function 在 text 字段上自动完成，
#       应用层不生成 sparse 向量，因此这里没有任何 sparse 模型配置。
RAG4C_MILVUS_URI=./rag4c.db
# 鉴权 token（server 模式需要，如 root:Milvus；Lite 模式留空）
RAG4C_MILVUS_TOKEN=
# 目标数据库名（默认库留空即可）
RAG4C_MILVUS_DB_NAME=
# 集合名
RAG4C_MILVUS_COLLECTION_NAME=rag4c_chunks
# 稠密向量维度（BGE-M3 固定为 1024）
RAG4C_MILVUS_DIM=1024
# text 字段 VARCHAR 最大长度
RAG4C_MILVUS_TEXT_MAX_LENGTH=65535
# 稠密索引类型：HNSW / IVF_FLAT / AUTOINDEX / FLAT / BRUTE_FORCE
RAG4C_MILVUS_INDEX_TYPE=HNSW
# 稠密距离度量：COSINE / L2 / IP
RAG4C_MILVUS_METRIC_TYPE=COSINE
RAG4C_MILVUS_NLIST=1024
RAG4C_MILVUS_M=16
RAG4C_MILVUS_EF_CONSTRUCTION=200
# 检索参数（nprobe 用于 IVF，ef 用于 HNSW；不适用会被 Milvus 忽略）
RAG4C_MILVUS_NPROBE=16
RAG4C_MILVUS_EF=64
# 内置 BM25 Function 稀疏索引参数
RAG4C_MILVUS_BM25_K1=1.2
RAG4C_MILVUS_BM25_B=0.75
RAG4C_MILVUS_BM25_DROP_RATIO_BUILD=0.2
# 混合检索：各分支候选放大系数（每路取 top_k * candidate_factor 再 RRF 融合）
RAG4C_MILVUS_CANDIDATE_FACTOR=4
# RRF 常数 k
RAG4C_MILVUS_RRF_K=60
# 操作超时（秒）
RAG4C_MILVUS_TIMEOUT=30.0
# 一致性级别：Strong / Session / Bounded / Eventually（Milvus Lite 仅支持 Strong）
RAG4C_MILVUS_CONSISTENCY_LEVEL=Bounded

# ---------------------------------------------------------------------------
# [embedding] 稠密嵌入
# ---------------------------------------------------------------------------
# provider = api（OpenAI 兼容 /embeddings 端点，默认指向硅基流动 SiliconFlow）
#          | local（本地 FlagEmbedding BGE-M3，需 pip install "rag4c[embedding]"）
# 默认方案 1：SiliconFlow + BAAI/bge-m3（1024 维，免费额度即可用）
RAG4C_EMBEDDING_PROVIDER=api
# 本地模型名（provider=local 时生效，首次调用会自动下载权重）
RAG4C_EMBEDDING_MODEL=BAAI/bge-m3
RAG4C_EMBEDDING_DIM=1024
# 运行设备：cpu / cuda / cuda:0 / mps（provider=local 时生效）
RAG4C_EMBEDDING_DEVICE=cpu
RAG4C_EMBEDDING_USE_FP16=false
# BGE-M3 最大输入长度（token）
RAG4C_EMBEDDING_MAX_LENGTH=8192
RAG4C_EMBEDDING_BATCH_SIZE=32
# 是否对输出向量做 L2 归一化
RAG4C_EMBEDDING_NORMALIZE_EMBEDDINGS=false
# ---- api provider 专用（默认 SiliconFlow）----
# 硅基流动：https://api.siliconflow.cn/v1，API Key 在 https://cloud.siliconflow.cn 获取
# Ollama 本地：http://localhost:11434/v1（模型如 bge-m3:latest）
RAG4C_EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
RAG4C_EMBEDDING_API_KEY=
RAG4C_EMBEDDING_API_MODEL=BAAI/bge-m3
RAG4C_EMBEDDING_API_TIMEOUT=120.0

# ---------------------------------------------------------------------------
# [reranker] 重排序（本地 BGE-reranker-v2-m3）
# ---------------------------------------------------------------------------
RAG4C_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG4C_RERANKER_DEVICE=cpu
RAG4C_RERANKER_USE_FP16=false
RAG4C_RERANKER_BATCH_SIZE=32
RAG4C_RERANKER_NORMALIZE_SCORE=true

# ---------------------------------------------------------------------------
# [llm] 业务 LLM 槽位（共 11 个，全部 OpenAI 兼容端点）
# 默认指向本地 Ollama（http://localhost:11434/v1），免费模型开箱即用。
# ---------------------------------------------------------------------------
#
# ## 推荐写法：具名提供商 + provider_ref
#
# 11 个槽位各写一遍 base_url/api_key 就是 22 个字段，换一家服务商要改 22 处。
# 把连接信息命名一次、槽位按名字引用，换服务商只改一行：
#
#   RAG4C_LLM_PROVIDERS_<名字>_BASE_URL=...
#   RAG4C_LLM_PROVIDERS_<名字>_API_KEY=...
#   RAG4C_LLM_<槽位>_PROVIDER_REF=<名字>
#   RAG4C_LLM_<槽位>_MODEL=<模型名>
#
# 内置了四个提供商，用它们时**只需补 API_KEY**，地址不用写：
#   ollama       http://localhost:11434/v1              （本机，key 也已内置）
#   siliconflow  https://api.siliconflow.cn/v1
#   deepseek     https://api.deepseek.com/v1
#   dashscope    https://dashscope.aliyuncs.com/compatible-mode/v1
#                （阿里云百炼 / 通义千问 Qwen；国内站与新加坡站
#                 dashscope-intl 的 key **不通用**，拿错站会 401）
#
# 名字大小写不敏感，也可以自己新增任意名字。
#
# 例：把生成与判定两个槽位指向通义千问，其余留在本机 ——
#   RAG4C_LLM_PROVIDERS_DASHSCOPE_API_KEY=sk-xxx
#   RAG4C_LLM_GENERATION_PROVIDER_REF=dashscope
#   RAG4C_LLM_GENERATION_MODEL=qwen3.7-max-2026-05-17
#   RAG4C_LLM_JUDGE_PROVIDER_REF=dashscope
#   RAG4C_LLM_JUDGE_MODEL=qwen3.7-max-2026-05-17
#
# 注意：用了 PROVIDER_REF 就**不要**再给同一个槽位写 BASE_URL/API_KEY。
# 槽位显式写过的字段一律压过提供商（这是设计好的逃生口，方便让某一个槽位
# 走别处），所以哪怕写的是同一个值，也会让继承对该字段失效。
#
# ## 另一种写法：每个槽位各写全套
#
# 下面这份是逐槽位的完整字段清单，适合各槽位用不同服务商的场景。
# 每个槽位可配：provider_ref / base_url / api_key / model / temperature /
#               timeout / max_tokens / seed
# ---------------------------------------------------------------------------
# 查询改写（把模糊问题改写为可检索的表述）
RAG4C_LLM_REWRITE_BASE_URL=http://localhost:11434/v1
RAG4C_LLM_REWRITE_API_KEY=ollama
RAG4C_LLM_REWRITE_MODEL=qwen2.5
RAG4C_LLM_REWRITE_TEMPERATURE=0.2
RAG4C_LLM_REWRITE_TIMEOUT=120.0
RAG4C_LLM_REWRITE_MAX_TOKENS=4096

# 路由决策（hybrid / vector_graph_rag / full）
RAG4C_LLM_ROUTER_LLM_BASE_URL=http://localhost:11434/v1
RAG4C_LLM_ROUTER_LLM_API_KEY=ollama
RAG4C_LLM_ROUTER_LLM_MODEL=qwen2.5
RAG4C_LLM_ROUTER_LLM_TEMPERATURE=0.1
RAG4C_LLM_ROUTER_LLM_TIMEOUT=120.0
RAG4C_LLM_ROUTER_LLM_MAX_TOKENS=4096

# 答案生成
RAG4C_LLM_GENERATION_BASE_URL=http://localhost:11434/v1
RAG4C_LLM_GENERATION_API_KEY=ollama
RAG4C_LLM_GENERATION_MODEL=qwen2.5
RAG4C_LLM_GENERATION_TEMPERATURE=0.7
RAG4C_LLM_GENERATION_TIMEOUT=120.0
RAG4C_LLM_GENERATION_MAX_TOKENS=4096

# 裁判 / 验证（Groundedness、Relevance、引用验证）
RAG4C_LLM_JUDGE_BASE_URL=http://localhost:11434/v1
RAG4C_LLM_JUDGE_API_KEY=ollama
RAG4C_LLM_JUDGE_MODEL=qwen2.5
RAG4C_LLM_JUDGE_TEMPERATURE=0.0
RAG4C_LLM_JUDGE_TIMEOUT=120.0
RAG4C_LLM_JUDGE_MAX_TOKENS=4096

# 三元组抽取（知识图谱入库；温度建议 0，保证确定性）
RAG4C_LLM_TRIPLET_BASE_URL=http://localhost:11434/v1
RAG4C_LLM_TRIPLET_API_KEY=ollama
RAG4C_LLM_TRIPLET_MODEL=qwen2.5
RAG4C_LLM_TRIPLET_TEMPERATURE=0.0
RAG4C_LLM_TRIPLET_TIMEOUT=120.0
RAG4C_LLM_TRIPLET_MAX_TOKENS=4096

# ---- 查询增强槽位（HyDE / 子查询 / Stepback / Contextual Retrieval）----
# 均在对应开关开启时被调用；温度 0 保证确定性输出
# HyDE：检索前生成"假设答案"文档，用其向量检索
RAG4C_LLM_HYDE_BASE_URL=http://localhost:11434/v1
RAG4C_LLM_HYDE_API_KEY=ollama
RAG4C_LLM_HYDE_MODEL=qwen2.5
RAG4C_LLM_HYDE_TEMPERATURE=0.0
RAG4C_LLM_HYDE_TIMEOUT=120.0
RAG4C_LLM_HYDE_MAX_TOKENS=4096

# 子查询拆解：把复杂查询拆成多个子查询
RAG4C_LLM_SUBQUERIES_BASE_URL=http://localhost:11434/v1
RAG4C_LLM_SUBQUERIES_API_KEY=ollama
RAG4C_LLM_SUBQUERIES_MODEL=qwen2.5
RAG4C_LLM_SUBQUERIES_TEMPERATURE=0.0
RAG4C_LLM_SUBQUERIES_TIMEOUT=120.0
RAG4C_LLM_SUBQUERIES_MAX_TOKENS=4096

# Stepback：生成更抽象的后退式问题
RAG4C_LLM_STEPBACK_BASE_URL=http://localhost:11434/v1
RAG4C_LLM_STEPBACK_API_KEY=ollama
RAG4C_LLM_STEPBACK_MODEL=qwen2.5
RAG4C_LLM_STEPBACK_TEMPERATURE=0.0
RAG4C_LLM_STEPBACK_TIMEOUT=120.0
RAG4C_LLM_STEPBACK_MAX_TOKENS=4096

# Contextual Retrieval：入库时为每个 chunk 生成文档级上下文
RAG4C_LLM_CONTEXTUAL_BASE_URL=http://localhost:11434/v1
RAG4C_LLM_CONTEXTUAL_API_KEY=ollama
RAG4C_LLM_CONTEXTUAL_MODEL=qwen2.5
RAG4C_LLM_CONTEXTUAL_TEMPERATURE=0.0
RAG4C_LLM_CONTEXTUAL_TIMEOUT=120.0
RAG4C_LLM_CONTEXTUAL_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# [pipeline] 检索管线（优化功能均为开关式设计）
# ---------------------------------------------------------------------------
# 混合检索（稠密 + BM25）开关
RAG4C_PIPELINE_HYBRID_SEARCH_ON=true
# BGE 重排开关
RAG4C_PIPELINE_RERANK_ON=true
# 知识图谱检索开关（由路由决定是否启用；关闭时命中 graph 也降级为 hybrid）
RAG4C_PIPELINE_GRAPH_RETRIEVAL_ON=true
# ACL 过滤开关
RAG4C_PIPELINE_ACL_FILTER_ON=true
# 结果来源多样性控制：off（纯混合检索）| group_only（按字段分组）| group_mmr（分组 + MMR）
RAG4C_PIPELINE_SOURCE_DIVERSITY=off
# 每组取多少条（group_only / group_mmr 使用）
RAG4C_PIPELINE_GROUP_SIZE=3
# 分组字段（通常是 doc_id，保证一个文档内部的多样性）
RAG4C_PIPELINE_GROUP_BY_FIELD=doc_id
# MMR 多样性-相关度权衡系数（越大越多样；group_mmr 使用）
RAG4C_PIPELINE_MMR_LAMBDA=0.7
# 是否启用复杂度门控（简单问题直接短路，跳过复杂检索链）
RAG4C_PIPELINE_COMPLEXITY_GATE_ON=true
# 双重阈值弃权：检索得分低于此阈值 -> 判定无足够证据
RAG4C_PIPELINE_RETRIEVAL_SCORE_THRESHOLD=0.3
# 引用蕴含得分低于此阈值 -> 判定答案不 grounded
RAG4C_PIPELINE_ENTAILMENT_SCORE_THRESHOLD=0.6
# 默认检索条数
RAG4C_PIPELINE_TOP_K=8

# ---- 可插拔检索增强开关（官方 how_to_enhance_your_rag 系列，默认关闭）----
# HyDE：检索前用 LLM 生成假设答案，用其向量检索
RAG4C_PIPELINE_HYDE_ON=false
# 子查询拆解：复杂查询拆多个子查询分别检索后合并
RAG4C_PIPELINE_SUBQUERIES_ON=false
# Stepback：生成更抽象的后退问题补充检索
RAG4C_PIPELINE_STEPBACK_ON=false
# 句子窗口：命中子块时按 parent_chunk_id 回取父块（small-to-big）
RAG4C_PIPELINE_SENTENCE_WINDOW_ON=false
# 子查询 / 后退问题各自检索时向 Milvus 请求的候选数
RAG4C_PIPELINE_ENHANCE_CANDIDATE_K=8
# LangGraph 图编排开关：优先用 StateGraph 编排 answer_query；
# 未安装 langgraph / 图构建或执行异常时自动回退顺序编排（行为一致）
RAG4C_PIPELINE_GRAPH_ENGINE_ON=true

# ---------------------------------------------------------------------------
# [graph] 知识图谱检索（vector-graph-rag 方案）
# ---------------------------------------------------------------------------
# 实体向量检索候选数与相似度阈值（低于阈值丢弃）
RAG4C_GRAPH_ENTITY_TOP_K=20
RAG4C_GRAPH_ENTITY_SIMILARITY_THRESHOLD=0.9
# 关系向量检索候选数与相似度阈值（-1.0 表示不过滤）
RAG4C_GRAPH_RELATION_TOP_K=20
RAG4C_GRAPH_RELATION_SIMILARITY_THRESHOLD=-1.0
# 子图扩展跳数：从命中实体沿 relation_ids 扩展几跳
RAG4C_GRAPH_EXPANSION_DEGREE=1
# 图检索返回的最终 chunk 条数
RAG4C_GRAPH_FINAL_TOP_K=3
# 是否用 LLM 对扩展后的关系做相关性重排
RAG4C_GRAPH_USE_LLM_RERANK=true

# ---------------------------------------------------------------------------
# [mineru] 文档解析（MinerU）
# ---------------------------------------------------------------------------
# provider = cli（本机 mineru CLI，npm 包 mineru-open-api）| http（MinerU HTTP API）
RAG4C_MINERU_PROVIDER=cli
# CLI 可执行文件名（默认 mineru-open-api）
RAG4C_MINERU_EXECUTABLE=mineru-open-api
# ---- http 模式专用 ----
# API 基础地址（默认 https://mineru.net）
RAG4C_MINERU_API_BASE=https://mineru.net
# API Token（留空走 v1 Agent 轻量 API，免 Token、10MB/20 页；配置后走 v4 精准 API，200MB/200 页）
RAG4C_MINERU_API_KEY=
# v4 精准 API 模型版本：vlm / pipeline / MinerU-HTML
RAG4C_MINERU_MODEL_VERSION=vlm
# 文档语言：ch（中英默认）/ en / japan / korean / chinese_cht / latin / th ...
RAG4C_MINERU_LANGUAGE=ch
# 扫描件 / 含文字图片启用 OCR
RAG4C_MINERU_ENABLE_OCR=true
RAG4C_MINERU_ENABLE_TABLE=true
RAG4C_MINERU_ENABLE_FORMULA=true
# 页数上限（超出拒绝解析，与 API 限额一致）
RAG4C_MINERU_PAGE_LIMIT=200
# 解析超时（秒）；CLI 首次运行可能下载模型，建议较大值
RAG4C_MINERU_TIMEOUT=900.0

# ---------------------------------------------------------------------------
# [observability] 可观测性
# ---------------------------------------------------------------------------
# 日志级别
RAG4C_OBSERVABILITY_LOG_LEVEL=INFO
# OpenTelemetry OTLP 端点（预留，置空则关闭；未来可指向 Langfuse / Jaeger）
RAG4C_OBSERVABILITY_OTEL_ENDPOINT=
# OTel 服务名
RAG4C_OBSERVABILITY_OTEL_SERVICE_NAME=rag4c
# 是否开启追踪收集
RAG4C_OBSERVABILITY_TRACING_ENABLED=true
# 是否开启进程内性能指标采集（计数 / 直方图 / P50/P95/P99）
RAG4C_OBSERVABILITY_METRICS_ENABLED=true

# ---------------------------------------------------------------------------
# [retry] 通用重试（指数退避 + 随机抖动；应用于 LLM / Milvus / 图节点等瞬态调用）
# ---------------------------------------------------------------------------
# 最大尝试次数（含首次）
RAG4C_RETRY_MAX_ATTEMPTS=3
# 首次失败后的退避基准（秒）
RAG4C_RETRY_BASE_DELAY=0.5
# 单次退避上限（秒）
RAG4C_RETRY_MAX_DELAY=30.0
# 随机抖动比例（0~1，避免惊群）
RAG4C_RETRY_JITTER=0.1
# 指数退避倍数（delay = min(base * factor^(attempt-1), max)）
RAG4C_RETRY_BACKOFF_FACTOR=2.0

# ---------------------------------------------------------------------------
# [tenant] 多租户隔离（单集合 + tenant_id 元数据过滤）
# ---------------------------------------------------------------------------
# 强制隔离开关：true 时问答 / 入库 / 检索一律归属有效租户（显式传入或回退
# default_tenant），跨租户数据不可见；false 时 tenant_id 为空表示不过滤
# （开发 / 单租户模式）
RAG4C_TENANT_ENFORCED=true
# 未显式指定租户时的匿名回退租户（存量数据默认归此租户）
RAG4C_TENANT_DEFAULT_TENANT=default

# ---------------------------------------------------------------------------
# [knowledge_security] KnowledgeOps Actor 与 OIDC Runtime
# ---------------------------------------------------------------------------
# OIDC 回调地址精确 allowlist。空数组表示 fail closed，生产 start 将拒绝所有 redirect_uri。
# 推荐使用 JSON 数组；仅允许 HTTPS，或用于本机开发的 loopback HTTP（localhost/127.0.0.1/::1）。
# 服务会规范化 scheme/host/default port、去重，并对请求中的 redirect_uri 做精确匹配。
RAG4C_KNOWLEDGE_SECURITY_OIDC_REDIRECT_URI_ALLOWLIST=[]
# 示例：
# RAG4C_KNOWLEDGE_SECURITY_OIDC_REDIRECT_URI_ALLOWLIST=["https://app.example.com/enterprise/sso/oidc/callback","http://localhost:1420/enterprise/sso/oidc/callback"]
