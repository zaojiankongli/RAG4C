{
  "name": "rag4c-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RAG4C 企业级 RAG 系统桌面问答控制台（Tauri 2 + React 18 + TypeScript + TDesign React）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/run-vitest-full.mjs",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write src",
    "test:single": "vitest run",
    "types:gen": "openapi-typescript src/types/generated/openapi.json -o src/types/generated/openapi.ts",
    "check:contract": "npm run types:gen && git diff --exit-code -- src/types/generated/openapi.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@tauri-apps/api": "^2.1.1",
    "@xyflow/react": "^12.11.3",
    "dayjs": "^1.11.13",
    "echarts": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tdesign-icons-react": "^0.6.10",
    "tdesign-react": "^1.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-test-renderer": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "^18.3.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
